// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum CollaboratorRole {
  VIEWER
  EDITOR
}

enum SharePermission {
  VIEW
  EDIT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SHARE
  INVITE
  RESTORE
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  avatar    String?   @default("https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1350&q=80")
  refreshToken  String? 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  notes         Note[]         @relation("UserNotes")
  tasks         Task[]
  collaborators Collaborator[]
  shareLinks    ShareLink[]
  invitations   Invitation[]   @relation("InvitedBy")
  auditLogs     AuditLog[]
}

model Note {
  id         Int      @id @default(autoincrement())
  title      String
  content    Json?
  ownerId    Int
  owner      User     @relation("UserNotes", fields: [ownerId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  collaborators Collaborator[]
  shareLinks    ShareLink[]
  invitations   Invitation[]
  auditLogs     AuditLog[]
  versions      NoteVersion[]
}

model Task {
  id        Int      @id @default(autoincrement())
  title     String
  description String?
  status    TaskStatus  @default(TODO)
  ownerId   Int
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collaborators Collaborator[] 

  
  @@index([ownerId])
  @@index([status])
}

model Collaborator {
  id      Int              @id @default(autoincrement())
  userId  Int
  noteId  Int?
  taskId  Int?
  role    CollaboratorRole @default(VIEWER)
  
  user    User     @relation(fields: [userId], references: [id])
  note    Note?    @relation(fields: [noteId], references: [id])
  task    Task?    @relation(fields: [taskId], references: [id])
}

model ShareLink {
  id          Int             @id @default(autoincrement())
  token       String          @unique
  noteId      Int
  createdById Int
  permission  SharePermission @default(VIEW)
  expiresAt   DateTime?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  
  note        Note            @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdBy   User            @relation(fields: [createdById], references: [id])
  
  @@index([token])
  @@index([noteId])
}

model Invitation {
  id          Int              @id @default(autoincrement())
  email       String
  noteId      Int
  invitedById Int
  role        CollaboratorRole @default(VIEWER)
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  note        Note             @relation(fields: [noteId], references: [id], onDelete: Cascade)
  invitedBy   User             @relation("InvitedBy", fields: [invitedById], references: [id])
  
  @@index([email])
  @@index([token])
  @@unique([email, noteId])
}

model AuditLog {
  id          Int         @id @default(autoincrement())
  action      AuditAction
  entityType  String      // "note", "task", etc.
  entityId    Int
  userId      Int
  noteId      Int?        // For quick filtering
  changes     Json?       // Store what changed
  metadata    Json?       // Additional context
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())
  
  user        User        @relation(fields: [userId], references: [id])
  note        Note?       @relation(fields: [noteId], references: [id], onDelete: Cascade)
  
  @@index([entityType, entityId])
  @@index([userId])
  @@index([noteId])
  @@index([createdAt])
}

model NoteVersion {
  id          Int      @id @default(autoincrement())
  noteId      Int
  title       String
  content     Json?
  version     Int      // Sequential version number
  createdById Int      // Who created this version
  createdAt   DateTime @default(now())
  
  note        Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  
  @@index([noteId])
  @@index([noteId, version])
  @@unique([noteId, version])
}